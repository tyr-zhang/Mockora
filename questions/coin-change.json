          2
        ],
        3
      ],
      "hidden": true
    },
    {
      "input": [
        [
          1
        ],
        0
      ],
      "hidden": true
    },
    {
      "input": [
        [
          5,
          7
        ],
        11
      ],
      "hidden": true
    }
  ]
}
