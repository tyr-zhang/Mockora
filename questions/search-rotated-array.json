          0,
          1,
          2
        ],
        3
      ],
      "hidden": false
    },
    {
      "input": [
        [
          5,
          1,
          3
        ],
        5
      ],
      "hidden": true
    },
    {
      "input": [
        [
          6,
          7,
          0,
          1,
          2,
          3,
          4
        ],
        7
      ],
      "hidden": true
    },
    {
      "input": [
        [
          1
        ],
        0
      ],
      "hidden": true
    }
  ]
}
